# Copy to .env.local for local overrides (optional).
# On Vercel, set these under Project → Settings → Environment Variables.
# Use the gateway origin only. Do not append /api (the app adds /api/... paths).
# Doctor profile photos from ERP use `/uploads/...` paths; the app resolves them via
# `/api/channeling/public/uploads/...` on this origin automatically.

VITE_CHANNELING_API_ORIGIN=https://channelinggatewayapi.openskylabz.com
VITE_RMO_API_BASE=https://channelinggatewayapi.openskylabz.com
VITE_RECEPTION_API_BASE=https://channelinggatewayapi.openskylabz.com
VITE_REVIEWS_API_BASE=https://channelinggatewayapi.openskylabz.com

# Landing-page enquiry email (local API on port 7001).
# Without SMTP, enquiries are saved to server/data/landing-enquiries.json.
# LANDING_ENQUIRY_TO=rmo01pcic@gmail.com
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=noreply@premiercare.lk
